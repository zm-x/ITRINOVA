                <div className={`p-4 lg:p-6 transition-all duration-1000 ${
                  isSwitching ? 'delay-0' : 'delay-800'
                } ${
                  (leoSectionAnimated || (sectionVisible && scrollEnabled && !isSwitching)) ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-8'
                }`}>
                  <h4 className="text-2xl lg:text-3xl font-semibold mb-4 text-blue-400">
                    Career Opportunities
                  </h4>
                  <p className="text-lg lg:text-xl leading-relaxed text-white">
                    Access exclusive job opportunities with leading space companies. Find positions that match your security clearance level and regulatory compliance requirements in the growing LEO economy.
