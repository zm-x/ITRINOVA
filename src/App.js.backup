                    <li><a href="#" className={`transition-colors duration-300 ${
                      isBusiness 
                        ? 'text-gray-600 hover:text-black' 
                        : 'text-gray-300 hover:text-white'
                    }`}>Leadership Team</a></li>
                    <li><a href="#" className={`transition-colors duration-300 ${
                      isBusiness 
                        ? 'text-gray-600 hover:text-black' 
