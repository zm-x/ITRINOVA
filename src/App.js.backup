                            ? 'h-16 lg:h-20 xl:h-24' 
                            : logo === '/sole.png'
                            ? 'h-28 lg:h-36 xl:h-44'
                            : 'h-24 lg:h-32 xl:h-40'
                        }`}
                      />
                    </div>
